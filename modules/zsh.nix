# Zsh user config (oh-my-zsh + powerlevel10k). On NixOS the system only sets
# zsh as login shell; everything user-facing lives here.
{ config, pkgs, lib, ... }:
{
  programs.zsh = {
    enable = true;

    oh-my-zsh = {
      enable = true;
      plugins = [
        "git"
        "docker"
        "docker-compose"
        "python"
        "pip"
        "virtualenv"
        "node"
        "npm"
        "yarn"
        "systemd"
        "sudo"
        "history"
        "colored-man-pages"
        "command-not-found"
        "extract"
        "z"
      ];
    };

    plugins = [
      {
        name = "powerlevel10k";
        src = pkgs.zsh-powerlevel10k;
        file = "share/zsh-powerlevel10k/powerlevel10k.zsh-theme";
      }
    ];

    initContent = lib.mkMerge [
      # Powerlevel10k instant prompt, must stay close to the top of .zshrc
      (lib.mkOrder 500 ''
        if [[ -r "''${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-''${(%):-%n}.zsh" ]]; then
          source "''${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-''${(%):-%n}.zsh"
        fi
      '')
      ''
        [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
      ''
    ];

    shellAliases = {
      ls = "eza --icons=auto";
      ll = "eza --icons=auto -l";
      la = "eza --icons=auto -la";

      tree = "eza --icons --tree";

      grep = "rg --color=auto";
      cat = "bat";
      top = "btop";
      find = "fd";

      # home-manager (this repo)
      hm-switch = "home-manager switch --flake ~/home-manager";
      hm-build = "home-manager build --flake ~/home-manager";
      hm-news = "home-manager news --flake ~/home-manager";
    };

    autosuggestion.enable = true;
    syntaxHighlighting.enable = true;

    history = {
      size = 10000;
      save = 10000;
      path = "${config.home.homeDirectory}/.zsh_history";
    };
  };

  # p10k prompt layout (generated by `p10k configure`)
  home.file.".p10k.zsh".source = ./p10k.zsh;

  distroPackages.candidates = with pkgs; [
    eza
    bat
    fd
    ripgrep
    fzf
    zoxide
    htop
    btop
    zsh-completions
  ];
}
